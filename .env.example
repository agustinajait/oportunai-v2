# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/oportunai"

# JWT Secret (cambiarlo por uno seguro en producción)
JWT_SECRET="oportunai-super-secret-jwt-key-2024-cambiar-en-prod"

# URL base de la app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Almacenamiento S3 (opcional por ahora)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_BUCKET_NAME="oportunai-videos"

# FFmpeg (opcional — si no está en PATH, especificá la ruta completa)
# FFMPEG_PATH="/usr/bin/ffmpeg"

# ── WhatsApp / Supabase Edge Functions ────────────────────────────────────────
# URL pública de las Edge Functions de Supabase (e.g. https://xxx.supabase.co/functions/v1)
SUPABASE_FUNCTIONS_URL=""

# Meta WhatsApp Business API
WHATSAPP_TOKEN=""          # Token de la app de Meta
WA_PHONE_NUMBER_ID=""      # ID del número de WhatsApp de Oportunai en Meta
WA_VERIFY_TOKEN="oportunai-webhook-2024"  # Token de verificación del webhook (también en la Edge Function)

# Korai webhook (shared secret entre Korai y Oportunai)
KORAI_WEBHOOK_SECRET=""

# Anthropic (para la Edge Function del bot)
# ANTHROPIC_API_KEY se configura directamente en los secrets de Supabase
