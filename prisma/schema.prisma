generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id              String   @id @default(cuid())
  nombre_completo String
  email           String   @unique
  password_hash   String
  telefono        String
  direccion       String
  dni             String   @unique
  role            Role     @default(user)
  bio             String?
  foto_url        String?
fecha_nacimiento DateTime?
  slug            String   @unique
  cv_datos        Json?
  alfa_digital    String?
  alfa_score      Int?
  google_id       String?  @unique
  grabaciones_cv  Int      @default(0)
  created_at      DateTime @default(now())

  videos                Video[]
  archivos              Archivo[]
  documentos            Documento[]
  taller_usuarios       TallerUsuario[]
  postulaciones         Postulacion[]
  empresa_miembros      EmpresaMiembro[]
  referencias           Referencia[]
  capacitaciones_ok     CapacitacionUsuario[]
  postulaciones_servicio PostulacionServicio[]
  modulos_asignados     ModuloAsignado[]
}

enum Role {
  super_admin
  admin
  user
  empleador
}

model Taller {
  id             String   @id @default(cuid())
  nombre         String
  descripcion    String?
  activo         Boolean  @default(true)
  habilita_cv    Boolean  @default(true)
  habilita_pitch Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  modulos         TallerModulo[]
  taller_usuarios TallerUsuario[]
  videos          Video[]
}

model TallerModulo {
  id            String    @id @default(cuid())
  taller_id     String
  tipo_video    TipoVideo
  nombre_modulo String
  duracion_base Int
  texto_guia    String
  orden         Int
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  taller Taller @relation(fields: [taller_id], references: [id], onDelete: Cascade)

  @@unique([taller_id, tipo_video, orden])
}

model TallerUsuario {
  id          String       @id @default(cuid())
  usuario_id  String
  taller_id   String
  estado      EstadoTaller @default(asignado)
  asignado_en DateTime     @default(now())
  validado_en DateTime?
  notas       String?

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  taller  Taller  @relation(fields: [taller_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, taller_id])
}

enum EstadoTaller {
  asignado
  completado
  validado
}

model Video {
  id              String    @id @default(cuid())
  user_id         String
  tipo            TipoVideo
  video_url       String
  es_fragmento    Boolean   @default(true)
  orden_fragmento Int?
  modulo_id       String?
  modulo_nombre   String?
  duracion_seg    Int?
  taller_id        String?
  oferta_id        String?
  section_attempts Json?
  created_at       DateTime  @default(now())

  usuario       Usuario       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  taller        Taller?       @relation(fields: [taller_id], references: [id], onDelete: SetNull)
  oferta        Oferta?       @relation(fields: [oferta_id], references: [id], onDelete: SetNull)
  postulaciones Postulacion[]
}

enum TipoVideo {
  video_cv
  video_pitch
}

model Archivo {
  id         String   @id @default(cuid())
  user_id    String
  file_url   String
  file_type  String
  created_at DateTime @default(now())

  usuario Usuario @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Documento {
  id         String        @id @default(cuid())
  user_id    String
  tipo       TipoDocumento
  file_url   String
  created_at DateTime      @default(now())

  usuario Usuario @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, tipo])
}

enum TipoDocumento {
  dni
  antecedentes_penales
  manipulacion_alimentos
  libreta_sanitaria
  registro_conducir
  otro
}

model ConfiguracionVideo {
  id            String    @id @default(cuid())
  tipo_video    TipoVideo
  nombre_modulo String
  duracion_base Int
  texto_guia    String
  orden         Int

  @@unique([tipo_video, orden])
}

model Empresa {
  id          String   @id @default(cuid())
  nombre      String
  slug        String   @unique
  logo_url    String?
  descripcion String?
  rubro       String?
  ciudad      String?
  sitio_web   String?
  activa              Boolean  @default(true)
  imagenes            String[] @default([])
  color_primario      String?
  fuente              String?
  mensaje_bienvenida  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  miembros          EmpresaMiembro[]
  ofertas           Oferta[]
  citas             Cita[]
  capacitaciones    Capacitacion[]
  servicios         Servicio[]
  modulos_asignados ModuloAsignado[]
}

model EmpresaMiembro {
  id          String         @id @default(cuid())
  empresa_id  String
  usuario_id  String
  rol_interno RolEmpresa     @default(recruiter)
  activo      Boolean        @default(true)
  created_at  DateTime       @default(now())

  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([empresa_id, usuario_id])
}

enum RolEmpresa {
  manager
  recruiter
}

model Oferta {
  id               String       @id @default(cuid())
  empresa_id       String
  titulo           String
  descripcion      String
  requisitos       String?
  area             String?
  modalidad        Modalidad    @default(presencial)
  ciudad           String?
  estado           EstadoOferta @default(activa)
  mensaje_whatsapp String?
  nombre_marca     String?
  logo_url         String?
  titulo_hero      String?
  docs_requeridos   String[]     @default([])
  preguntas_videocv String[]     @default([])
  created_at        DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  empresa            Empresa       @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  postulaciones      Postulacion[]
  videos_especificos Video[]
  citas              Cita[]
}

enum Modalidad {
  presencial
  remoto
  hibrido
}

enum EstadoOferta {
  activa
  pausada
  cerrada
}

model Postulacion {
  id         String            @id @default(cuid())
  oferta_id  String
  usuario_id String
  video_id   String
  estado     EstadoPostulacion @default(pendiente)
  nota       String?
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  oferta  Oferta  @relation(fields: [oferta_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  video   Video   @relation(fields: [video_id], references: [id], onDelete: Restrict)
  citas   CitaInvitado[]

  @@unique([oferta_id, usuario_id])
}

enum EstadoPostulacion {
  pendiente
  visto
  interesado
  contactar
  en_proceso
  contratado
  bolsa_talentos
  descartado
}

model Cita {
  id          String        @id @default(cuid())
  empresa_id  String
  oferta_id   String?
  fecha       DateTime
  modalidad   CitaModalidad @default(virtual)
  lugar       String
  mensaje     String?
  grupal      Boolean       @default(false)
  created_at  DateTime      @default(now())

  empresa   Empresa        @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  oferta    Oferta?        @relation(fields: [oferta_id], references: [id], onDelete: SetNull)
  invitados CitaInvitado[]
}

enum CitaModalidad {
  presencial
  virtual
}

model CitaInvitado {
  id             String     @id @default(cuid())
  cita_id        String
  postulacion_id String
  estado         EstadoCita @default(pendiente)
  respondido_en  DateTime?
  created_at     DateTime   @default(now())

  cita        Cita        @relation(fields: [cita_id], references: [id], onDelete: Cascade)
  postulacion Postulacion @relation(fields: [postulacion_id], references: [id], onDelete: Cascade)

  @@unique([cita_id, postulacion_id])
}

enum EstadoCita {
  pendiente
  confirmada
  rechazada
}

model Referencia {
  id               String    @id @default(cuid())
  usuario_id       String
  empresa_nombre   String
  referidor_nombre String
  referidor_cargo  String?
  referidor_email  String?
  token            String    @unique @default(cuid())
  estado           String    @default("pendiente")
  fecha_validada   DateTime?
  mensaje          String?
  created_at       DateTime  @default(now())

  usuario          Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

model Capacitacion {
  id                 String   @id @default(cuid())
  empresa_id         String
  titulo             String
  descripcion        String?
  video_url          String
  rubro              String?
  activa             Boolean  @default(true)
  pregunta           String
  opciones           Json
  respuesta_correcta Int
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  empresa     Empresa               @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  completadas CapacitacionUsuario[]
  servicios   Servicio[]
}

model CapacitacionUsuario {
  id              String   @id @default(cuid())
  usuario_id      String
  capacitacion_id String
  completada_en   DateTime @default(now())

  usuario      Usuario      @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  capacitacion Capacitacion @relation(fields: [capacitacion_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, capacitacion_id])
}

// ─── MÓDULOS DE SERVICIO ────────────────────────────────────────────────────

model Servicio {
  id                 String           @id @default(cuid())
  empresa_id         String
  titulo             String
  descripcion        String
  frecuencia         FrecuenciaModulo @default(mensual)
  deadline           DateTime?
  capacitacion_id    String?
  contrato_template  String?
  protocolo          Json             // [{item: string, descripcion: string}]
  estado             EstadoServicio   @default(activo)
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  empresa           Empresa               @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  capacitacion      Capacitacion?         @relation(fields: [capacitacion_id], references: [id], onDelete: SetNull)
  postulaciones     PostulacionServicio[]
  modulos_asignados ModuloAsignado[]
}

enum FrecuenciaModulo {
  diaria
  semanal
  mensual
  unica
}

enum EstadoServicio {
  activo
  cerrado
}

model PostulacionServicio {
  id          String                    @id @default(cuid())
  servicio_id String
  usuario_id  String
  estado      EstadoPostulacionServicio @default(pendiente)
  created_at  DateTime                  @default(now())
  updated_at  DateTime                  @updatedAt

  servicio Servicio @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([servicio_id, usuario_id])
}

enum EstadoPostulacionServicio {
  pendiente
  aceptado
  rechazado
}

model ModuloAsignado {
  id           String       @id @default(cuid())
  servicio_id  String
  usuario_id   String
  empresa_id   String
  protocolo    Json         // copia del protocolo al momento de asignación
  estado       EstadoModulo @default(en_progreso)
  fecha_inicio DateTime     @default(now())
  deadline     DateTime?
  contrato_url String?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  servicio   Servicio        @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  usuario    Usuario         @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  empresa    Empresa         @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  evidencias EvidenciaItem[]
  remito     Remito?
}

enum EstadoModulo {
  en_progreso
  en_riesgo
  completado
  aprobado
}

model EvidenciaItem {
  id          String          @id @default(cuid())
  modulo_id   String
  item_index  Int
  texto       String?
  archivo_url String?
  estado      EstadoEvidencia @default(pendiente)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  modulo ModuloAsignado @relation(fields: [modulo_id], references: [id], onDelete: Cascade)

  @@unique([modulo_id, item_index])
}

enum EstadoEvidencia {
  pendiente
  aprobado
  rechazado
}

model Remito {
  id            String   @id @default(cuid())
  modulo_id     String   @unique
  numero_remito String   @unique
  pdf_url       String?
  created_at    DateTime @default(now())

  modulo ModuloAsignado @relation(fields: [modulo_id], references: [id], onDelete: Cascade)
}

model GaleriaHome {
  id         String   @id @default(cuid())
  src        String
  label      String
  orden      Int      @default(0)
  big        Boolean  @default(false)
  activa     Boolean  @default(true)
  created_at DateTime @default(now())
}
